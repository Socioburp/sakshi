# Sakshi v2 — environment template
#
# cp .env.example .env  and fill in per PROVISIONING.md
# app/config.py is the only reader of the environment; every key below maps to a
# field on Settings. Anything left blank falls back to the default in that file.
#
# Defaults below run the whole product with NO vendor accounts:
#   WA_PROVIDER=mock  STT_PROVIDER=mock  IMAGEGEN_PROVIDER=mock  INSTAGRAM_MOCK=true
# That is enough for `make dev`, `make worker`, `make smoke` and `make test`.

# ---- core ----------------------------------------------------------------
ENV=dev                                   # dev | staging | prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000     # must be the public https URL in prod:
                                          # Meta webhooks and the IG OAuth callback
                                          # are built from it

# ---- postgres (Neon, ap-southeast-1, pooled) -----------------------------
# Use the POOLED Neon connection string (-pooler in the host) and keep
# ?sslmode=require. Driver prefix must be postgresql+psycopg (psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sakshi
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- redis (Upstash) -----------------------------------------------------
# Upstash gives a rediss:// URL — keep the double s (TLS).
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=sakshi:jobs

# ---- anthropic (the agent loop) ------------------------------------------
ANTHROPIC_API_KEY=
# Deliberately blank. Copy the exact model id from console.anthropic.com.
# The app refuses to start the agent rather than guessing one.
ANTHROPIC_MODEL=
AGENT_MAX_TURNS=12
AGENT_MAX_TOKENS=4096

# ---- voyage (brand_memory embeddings) ------------------------------------
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Must match the vector(n) width in migrations/versions/0001_initial.py.
# Changing it means a migration, not just an env edit.
EMBED_DIM=1024

# ---- cloudflare r2 (creative storage) ------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sakshi-creatives
# Public read URL for the bucket (custom domain or r2.dev). WhatsApp and the
# Instagram container API both fetch the image from here, so it must be
# publicly reachable — not a signed-URL-only bucket.
R2_PUBLIC_BASE_URL=

# ---- whatsapp ------------------------------------------------------------
WA_PROVIDER=mock                          # meta | gupshup | twilio | mock
# Any string you like; echoed back during Meta's webhook verification handshake.
WA_VERIFY_TOKEN=dev-verify-token

# --- meta cloud api (WA_PROVIDER=meta)
WA_APP_SECRET=                            # used to verify X-Hub-Signature-256
WA_ACCESS_TOKEN=                          # permanent system-user token, not the 24h one
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v21.0

# --- gupshup (WA_PROVIDER=gupshup)
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=

# --- twilio (WA_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- instagram (Track A) -------------------------------------------------
# Leave true until Instagram app review clears; the four client signatures are
# real, only the transport is stubbed.
INSTAGRAM_MOCK=true
IG_APP_ID=
IG_APP_SECRET=
# Must match the redirect URI registered on the Meta app, exactly, including
# scheme and trailing path. Instagram Login — not the Facebook-Page path.
IG_REDIRECT_URI=
# Insights (reach, saves, shares per post) need the
# instagram_business_manage_insights permission from App Review. Flip to true
# once granted: the connect link then asks for it and the daily sync reads
# numbers. With INSTAGRAM_MOCK=true the fixtures answer regardless.
IG_INSIGHTS_ENABLED=false

# ---- speech to text ------------------------------------------------------
# Pick this on `make bakeoff` product-name recall, not vendor benchmarks.
STT_PROVIDER=mock                         # mock | elevenlabs | deepgram | sarvam
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=

# ---- image generation ----------------------------------------------------
# Three vendors serve the same open-weight FLUX family behind one interface;
# switch with IMAGEGEN_PROVIDER, A/B on the same briefs. Prices (Sep 2026):
#   fal        FLUX.1 [schnell]  $0.003 per megapixel (~$0.0044 for a 4:5 post)
#   replicate  FLUX.1 [schnell]  $3.00 per thousand images
#   bfl        FLUX.2 [klein] 4B $0.014 first megapixel; flux-2-pro $0.03
IMAGEGEN_PROVIDER=mock                    # mock | fal | replicate | bfl
FAL_KEY=
IMAGEGEN_FAL_MODEL=fal-ai/flux/schnell    # or fal-ai/flux-2/klein/4b
REPLICATE_API_TOKEN=
IMAGEGEN_REPLICATE_MODEL=black-forest-labs/flux-schnell
BFL_API_KEY=
IMAGEGEN_BFL_MODEL=flux-2-klein-4b        # or flux-2-pro
# What the ledger records per generated image, in micro-dollars. Leave 0 for
# the vendor list price (fal 4400, replicate 3000, bfl 14000).
IMAGEGEN_COST_MICROS=0

# ---- compositor ----------------------------------------------------------
# Empty = the Chromium `playwright install` fetched. Set to a `chrome` binary
# path to use one the host already ships.
CHROMIUM_EXECUTABLE=

# ---- product lane (background replacement on the owner's own photos) -----
# Runs on CPU with an MIT-licensed model. Turn off on a worker with <1.5GB RAM.
CUTOUT_ENABLED=true
CUTOUT_MODEL=isnet-general-use             # birefnet-general-lite needs >4GB RAM

# ---- billing (razorpay) --------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate from the key secret. Set it on the webhook in the Razorpay
# dashboard and paste the same value here.
RAZORPAY_WEBHOOK_SECRET=
FREE_TRIAL_CREDITS=10
