# ---- secrets -------------------------------------------------------------
# app/config.py reads .env via pydantic-settings. Never commit the real one.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ---- python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- virtualenvs ---------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---- test / lint caches --------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
