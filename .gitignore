# ---- this project --------------------------------------------------------
# `make smoke` (scripts/journey_smoke.py) writes rendered creatives here
out/
# Real client voice notes for `make bakeoff` are private data.
# The manifest that describes them IS tracked; the audio is not.
samples/voice_notes/*
!samples/voice_notes/manifest.json
!samples/voice_notes/.gitkeep
# scratch renders / compositor debug output
tmp/
*.local.*

# ---- playwright ----------------------------------------------------------
# browsers install outside the repo, but the trace/report dirs land here
playwright-report/
test-results/
.playwright/

