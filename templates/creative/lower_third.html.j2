{% extends "_base.html.j2" %}
{% set hl = slide.headline|length %}
{% set hf = 0.104 if hl < 18 else (0.092 if hl < 30 else (0.080 if hl < 42 else 0.070)) %}
{% block styles %}
  {# Weighted to the bottom third, but eased: the photograph stays legible in
     its top two thirds instead of dying under a black wash. #}
  .scrim { background: linear-gradient(180deg,
      rgba(0,0,0,calc(.30*var(--k))) 0%, rgba(0,0,0,calc(.06*var(--k))) 22%, rgba(0,0,0,calc(0*var(--k))) 40%,
      rgba(0,0,0,calc(.20*var(--k))) 58%, rgba(0,0,0,calc(.52*var(--k))) 76%, rgba(0,0,0,calc(.76*var(--k))) 100%); }
  .content { justify-content: flex-end; text-align: start; }
  .headline { font-size: {{ (width * hf)|round|int }}px; max-width: 84%; }
  .subhead { font-size: {{ (width*0.036)|round|int }}px; max-width: 70%; }
  .cta { margin-top: {{ (width*0.044)|round|int }}px; }
  {# Both edges pinned to the safe zone: with only `left` set the brand name
     had no right bound and a long one ran off the canvas. A flex row, so the
     mark sits at the START edge -- the right, when the copy is Urdu. #}
  .top { position: absolute; top: {{ pad_top }}px; left: {{ pad_x }}px; right: {{ pad_x }}px;
         display: flex; justify-content: flex-start; text-align: start; }
  {# Accent hairline: a small, deliberate mark that ties the copy block to the
     brand colour without another coloured shape competing with the CTA. #}
  .rule { width: {{ (width*0.10)|round|int }}px; height: {{ (width*0.008)|round|int }}px;
          background: {{ brand.accent }}; border-radius: 999px;
          margin: 0 0 {{ (width*0.030)|round|int }}px; }
{% endblock %}
{% block body %}
  <div class="top">
    {% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url }}" alt="">
    {% else %}<span class="brandline" dir="auto">{{ brand.name }}</span>{% endif %}
  </div>
  <div class="content">
    <div class="rule"></div>
    <h1 class="headline" dir="auto">{{ slide.headline }}</h1>
    {% if slide.subhead %}<p class="subhead" dir="auto">{{ slide.subhead }}</p>{% endif %}
    {% if show_cta %}<div class="cta" dir="auto">{{ brief.cta }}</div>{% endif %}
  </div>
{% endblock %}
