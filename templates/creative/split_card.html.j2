{% extends "_base.html.j2" %}
{% set hl = slide.headline|length %}
{% set hf = 0.088 if hl < 20 else (0.078 if hl < 32 else 0.068) %}
{# The panel needs room for the words whatever the aspect: 40% of the height,
   or 44% of the width on a square post where the grid-safe padding is wide. #}
{% set panel_h = [(height*0.40)|round|int, (width*0.44)|round|int]|max %}
{% set photo_h = height - panel_h + (width*0.03)|round|int %}
{% block styles %}
  {# The photograph gets the top uncropped by text; the panel below is where
     the words live, so nothing is ever set over a busy area. #}
  .bg { height: {{ photo_h }}px; }
  .scrim { height: {{ photo_h }}px;
           background: linear-gradient(180deg, rgba(0,0,0,.22) 0%, rgba(0,0,0,0) 38%); }
  .grain { height: {{ photo_h }}px; }
  {# Auto height: the panel is as tall as the words need (never shorter than
     the design, never more than 62% of the frame) and the photograph takes
     what is left -- FIT_JS's reflow() reads data-photo-above and resizes it.
     A fixed-height panel is how copy gets cropped. #}
  .panel { position: absolute; left: 0; right: 0; bottom: 0;
           min-height: {{ panel_h }}px; max-height: {{ (height*0.62)|round|int }}px;
           background: {{ brand.primary }};
           border-radius: {{ (width*0.055)|round|int }}px {{ (width*0.055)|round|int }}px 0 0;
           padding: {{ (width*0.072)|round|int }}px {{ pad_x }}px {{ [pad_bottom, (width*0.072)|round|int]|max }}px;
           display: flex; flex-direction: column;
           box-shadow: 0 -{{ (width*0.012)|round|int }}px
                       {{ (width*0.05)|round|int }}px rgba(0,0,0,.28); }
  .headline { font-size: {{ (width * hf)|round|int }}px; color: {{ brand.ink }};
              text-shadow: none; }
  .subhead { font-size: {{ (width*0.033)|round|int }}px; text-shadow: none; max-width: 86%; }
  {# Wraps: a wide wordmark and a long CTA take a row each rather than one
     pushing the other off the canvas. #}
  .footrow { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; row-gap: {{ (width*0.03)|round|int }}px;
             gap: {{ (width*0.04)|round|int }}px; margin-top: auto;
             padding-top: {{ (width*0.045)|round|int }}px; }
  .footrow .logo { filter: none; }
{% endblock %}
{% block body %}
  <div class="panel" data-photo-above data-overlap="{{ (width*0.03)|round|int }}">
    <h1 class="headline" dir="auto">{{ slide.headline }}</h1>
    {% if slide.subhead %}<p class="subhead" dir="auto">{{ slide.subhead }}</p>{% endif %}
    <div class="footrow">
      {% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url }}" alt="">
      {% else %}<span class="brandline" dir="auto">{{ brand.name }}</span>{% endif %}
      {% if show_cta %}<span class="cta" dir="auto">{{ brief.cta }}</span>{% endif %}
    </div>
  </div>
{% endblock %}
