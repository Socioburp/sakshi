{% extends "_base.html.j2" %}
{% block styles %}
  .scrim { background: linear-gradient(180deg, rgba(0,0,0,.55) 0%, rgba(0,0,0,.15) 45%,
           rgba(0,0,0,.70) 100%); }
  .content { justify-content: center; text-align: center; align-items: center; }
  .headline { font-size: {{ (width * (0.115 if slide.headline|length < 18 else 0.082))|round|int }}px;
              max-width: 88%; }
  .subhead { font-size: {{ (width*0.040)|round|int }}px; max-width: 78%; }
  .cta { align-self: center; margin-top: {{ (width*0.055)|round|int }}px; }
  .foot { position: absolute; left: 0; right: 0; bottom: {{ (width*0.055)|round|int }}px;
          display: flex; justify-content: center; align-items: center; }
{% endblock %}
{% block body %}
  <div class="scrim"></div>
  <div class="content">
    <h1 class="headline">{{ slide.headline }}</h1>
    {% if slide.subhead %}<p class="subhead">{{ slide.subhead }}</p>{% endif %}
    {% if show_cta %}<div class="cta">{{ brief.cta }}</div>{% endif %}
  </div>
  <div class="foot">
    {% if brand.logo_url %}<img class="logo" src="{{ brand.logo_url }}" alt="">
    {% else %}<span class="brandline">{{ brand.name }}</span>{% endif %}
  </div>
{% endblock %}
